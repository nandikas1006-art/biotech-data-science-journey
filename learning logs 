        "!pip install biopython\n",
        "\n",
        "# 2. Import the sequence tool\n",
        "from Bio.Seq import Seq\n",
        "\n",
        "# 3. Create a mock DNA strand (coding strand)\n",
        "my_dna = Seq(\"ATGGCCATTGTAATGGGCCGCTGAAAGGGTCCCGGG\")\n",
        "print(f\"Original DNA Sequence: {my_dna}\")\n",
        "\n",
        "# 4. Transcribe it to mRNA\n",
        "my_mrna = my_dna.transcribe()\n",
        "print(f\"Transcribed mRNA:      {my_mrna}\")\n",
        "\n",
        "# 5. Translate it to a protein sequence\n",
        "my_protein = my_mrna.translate()\n",
        "print(f\"Translated Protein:    {my_protein}\")"
